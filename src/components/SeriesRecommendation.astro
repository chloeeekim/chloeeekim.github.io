---
import IconBook from "@/assets/icons/IconBook.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { formatSeriesRange } from "@/utils/formatSeriesRange";
import type { SeriesWithPosts } from "@/utils/getSeries";

/**
 * 시리즈에 속하지 않은 글 하단의 추천 시리즈.
 *
 * 카드는 /series 목록의 것을 그대로 쓴다. 같은 걸 가리키는 카드가 화면마다
 * 다르게 생기면 같은 것인 줄 모른다. 고르는 기준은 getRecommendedSeries 참고.
 */
type Props = {
  series: SeriesWithPosts[];
};

const { series } = Astro.props;
---

{
  series.length > 0 && (
    <section
      class="mt-10"
      data-pagefind-ignore
      aria-labelledby="series-recommendation-title"
    >
      <div class="mb-4 flex items-center gap-3">
        <h2
          id="series-recommendation-title"
          class="font-firacode text-xs font-medium tracking-widest text-foreground/60 uppercase"
        >
          Read next
        </h2>
        <div
          class="h-px flex-1 bg-linear-to-r from-border/40 to-transparent"
          aria-hidden="true"
        />
      </div>

      <ul class="grid gap-3 sm:grid-cols-2">
        {series.map(({ series: s, posts }) => (
          <li>
            <a
              href={`/series/${s.slug}/`}
              class="group flex h-full flex-col rounded-2xl border border-border/20 bg-muted/5 px-5 py-5 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5 sm:px-6"
            >
              <div class="flex items-center justify-between gap-3">
                <h3 class="flex items-center gap-2 text-base font-semibold transition-colors duration-200 group-hover:text-accent">
                  <IconBook
                    class="size-4 shrink-0 text-accent/70"
                    aria-hidden="true"
                  />
                  {s.title}
                </h3>
                <IconArrowRight class="size-4 shrink-0 text-accent/0 transition-all duration-300 group-hover:translate-x-0.5 group-hover:text-accent/70" />
              </div>

              <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-foreground/60">
                {s.description}
              </p>

              <div class="mt-auto pt-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-firacode text-xs text-foreground/45">
                <span class="text-accent/80">
                  {`${posts.length} ${posts.length === 1 ? "post" : "posts"}`}
                </span>
                <span class="opacity-40">·</span>
                <span>{formatSeriesRange(posts)}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
