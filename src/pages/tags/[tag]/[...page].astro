---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import PageHero from "@/components/PageHero.astro";
import Pagination from "@/components/Pagination.astro";
import RememberBackUrl from "@/components/RememberBackUrl.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;

const tagOgImage = `/tags/${tag}/og.png`;

// Prevent duplicate metadata in tag pagination pages
const metaTitle = page.currentPage > 1
  ? `Tag: ${tagName} (Page ${page.currentPage} of ${page.lastPage}) | ${SITE.title}`
  : `Tag: ${tagName} | ${SITE.title}`;

const tagDescription = page.currentPage > 1
  ? `Posts tagged "${tagName}" on ${SITE.title} (Page ${page.currentPage} of ${page.lastPage}).`
  : `Posts tagged "${tagName}" on ${SITE.title}.`;

const prevURL = page.url.prev ? new URL(page.url.prev, SITE.website).toString() : undefined;
const nextURL = page.url.next ? new URL(page.url.next, SITE.website).toString() : undefined;

---

<Layout
  title={metaTitle}
  description={tagDescription}
  ogImage={tagOgImage}
  prev={prevURL}
  next={nextURL}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <RememberBackUrl />
    <PageHero
      class="mb-8"
      titlePrefix="Tag:"
      title={tagName}
      transitionName={tag}
      desc={`Everything tagged "${tagName}".`}
      badges={[
        `${page.total} ${page.total === 1 ? "post" : "posts"}`,
        page.lastPage > 1 && `Page ${page.currentPage}/${page.lastPage}`,
      ]}
    />

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 [&>li]:my-0">
      {page.data.map(data => (
        <Card {...data} />
      ))}
    </ul>

    <Pagination {page} />
  </main>

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

