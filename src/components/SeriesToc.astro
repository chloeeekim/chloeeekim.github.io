---
import IconBook from "@/assets/icons/IconBook.svg";
import SeriesTocItem from "@/components/SeriesTocItem.astro";
import type { SeriesContext } from "@/utils/getSeries";

type Props = {
  context: SeriesContext;
};

const {
  context: { series, posts, index },
} = Astro.props;

const seriesUrl = `/series/${series.slug}/`;

/**
 * 현재 글 앞뒤로 몇 편까지 펼쳐 둘지. 9 편짜리 시리즈를 통째로 깔면 목차만
 * 화면 하나를 채우고, 비슷하게 생긴 제목이 늘어서서 훑기도 어렵다.
 *
 * 잘린 쪽은 접어 두되 목록 안에 그대로 둔다. "N more" 를 누르면 그 자리에서
 * 펼쳐진다. 시리즈 페이지로 보내면 읽던 글을 떠나야 해서 오히려 번거롭다.
 * <details> 라 JS 없이 동작하고, 뷰 트랜지션 뒤에도 다시 묶어 줄 게 없다.
 */
const WINDOW = 2;
const start = Math.max(0, index - WINDOW);
const end = Math.min(posts.length - 1, index + WINDOW);

const before = posts.slice(0, start);
const visible = posts.slice(start, end + 1);
const after = posts.slice(end + 1);
---

<section
  data-pagefind-ignore
  aria-label={`${series.title} 시리즈 목차`}
  class="series-toc rounded-2xl border border-border/20 bg-muted/5 px-5 py-5 backdrop-blur-sm sm:px-6"
>
  <div class="flex items-baseline justify-between gap-3">
    <h2 class="text-base font-semibold">
      <a
        href={seriesUrl}
        class="group flex items-center gap-2 transition-colors duration-200 hover:text-accent"
      >
        <IconBook class="size-4 shrink-0 text-accent/70" aria-hidden="true" />
        {series.title}
      </a>
    </h2>
    <span
      class="shrink-0 font-firacode text-xs whitespace-nowrap text-foreground/45"
    >
      {posts.length} {posts.length === 1 ? "post" : "posts"}
    </span>
  </div>

  <p class="mt-2 text-sm leading-relaxed text-foreground/60">
    {series.description}
  </p>

  <ol class="mt-4 flex flex-col gap-0.5">
    {
      before.length > 0 && (
        <li>
          <details class="series-more">
            <summary class="series-more-summary">
              <span class="series-more-dots" aria-hidden="true">
                &ctdot;
              </span>
              <span class="series-more-label">{before.length} more</span>
            </summary>
            <ol class="mt-0.5 flex flex-col gap-0.5">
              {before.map((post, i) => (
                <SeriesTocItem post={post} number={i + 1} />
              ))}
            </ol>
          </details>
        </li>
      )
    }

    {
      visible.map((post, offset) => (
        <SeriesTocItem
          post={post}
          number={start + offset + 1}
          isCurrent={start + offset === index}
        />
      ))
    }

    {
      after.length > 0 && (
        <li>
          <details class="series-more">
            <summary class="series-more-summary">
              <span class="series-more-dots" aria-hidden="true">
                &ctdot;
              </span>
              <span class="series-more-label">{after.length} more</span>
            </summary>
            <ol class="mt-0.5 flex flex-col gap-0.5">
              {after.map((post, i) => (
                <SeriesTocItem post={post} number={end + 2 + i} />
              ))}
            </ol>
          </details>
        </li>
      )
    }
  </ol>
</section>

<style>
  /* 기본 삼각형 마커를 지우고 목록 항목과 같은 눈금에 맞춘다 */
  .series-more-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--foreground) 40%, transparent);
    cursor: pointer;
    list-style: none;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .series-more-summary::-webkit-details-marker {
    display: none;
  }

  .series-more-summary:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .series-more-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 항목 번호 배지와 같은 폭이라 제목 왼쪽 선이 흐트러지지 않는다 */
  .series-more-dots {
    display: inline-flex;
    width: 1.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    font-family: var(--font-firacode, monospace);
  }

  /* 한 번 펼치면 그걸로 끝이고 여는 버튼은 사라진다. 글 맨 아래에 있는 목차라
     다시 접을 일이 거의 없고, 남겨 두면 <details> 가 내용을 늘 summary 아래에
     붙이는 탓에 아래쪽 그룹에서는 접기 버튼이 목록 중간에 끼어 버린다. */
  .series-more[open] > summary {
    display: none;
  }
</style>
