---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

/* ========== Formatted Datetime ========== */
const locale = SITE.lang || "en";
const localeCode = locale.toLowerCase().split("-")[0] || "en";
const resolvedTimezone = postTimezone || SITE.timezone;

const publishedDatetime = dayjs(pubDatetime).tz(resolvedTimezone);
const modifiedDatetime = modDatetime
  ? dayjs(modDatetime).tz(resolvedTimezone)
  : null;

const isModified = Boolean(
  modifiedDatetime?.isValid() &&
    publishedDatetime.isValid() &&
    modifiedDatetime.isAfter(publishedDatetime)
);

const format = (d: dayjs.Dayjs) => d.locale(localeCode).format("D MMM, YYYY");
const srFormat = (d: dayjs.Dayjs) =>
  new Intl.DateTimeFormat(locale, {
    dateStyle: "long",
    timeZone: resolvedTimezone,
  }).format(d.toDate());

// 발행일은 언제나 보여주고, 수정됐을 때만 뒤에 덧붙인다. 수정일로 갈아끼우면
// 2016 년 글이 목록에서 "2026" 으로만 보여 언제 쓴 글인지 알 수 없다.
const textSize = ["text-sm", size === "lg" ? "sm:text-base" : ""];
---

<div
  class:list={[
    "flex flex-wrap items-center gap-x-2 gap-y-0.5 text-foreground/80",
    className,
  ]}
>
  <IconCalendar
    aria-hidden="true"
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />

  <time
    class:list={[...textSize, "whitespace-nowrap"]}
    datetime={publishedDatetime.toISOString()}
    title={srFormat(publishedDatetime)}
    aria-label={`Published date: ${srFormat(publishedDatetime)}`}
    >{format(publishedDatetime)}</time
  >

  {
    isModified && modifiedDatetime && (
      <span class="flex items-center gap-x-1">
        <span aria-hidden="true" class="opacity-50">
          ·
        </span>
        <span aria-hidden="true" class:list={textSize}>
          updated
        </span>
        <time
          class:list={[...textSize, "whitespace-nowrap"]}
          datetime={modifiedDatetime.toISOString()}
          title={srFormat(modifiedDatetime)}
          aria-label={`Updated date: ${srFormat(modifiedDatetime)}`}
        >
          {format(modifiedDatetime)}
        </time>
      </span>
    )
  }
</div>
