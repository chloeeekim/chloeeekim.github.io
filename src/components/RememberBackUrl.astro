---
/**
 * 이 페이지를 "돌아갈 목록" 으로 기록한다.
 *
 * Breadcrumb 의 `cd ..` 버튼이 sessionStorage 의 backUrl 을 읽어 간다.
 * 원래는 목록 페이지마다 같은 스크립트를 복사해 두는 구조였는데, /posts 와
 * /archives 에는 빠져 있어서 거기서 글을 열면 그 전에 들렀던 태그 목록으로
 * 돌아가 버렸다. 한 곳으로 모아 빠진 페이지를 메운다.
 *
 * 글 상세에는 넣지 않는다. 표시가 없는 페이지에서는 아무것도 쓰지 않으므로
 * 글을 열어도 "내가 보던 목록" 이 그대로 남는다.
 *
 * 기본값은 현재 주소(쿼리 포함)다. /posts/2 처럼 페이지를 넘긴 상태면 그
 * 페이지로 돌아온다. /search 는 검색어가 입력에 따라 바뀌어서 자체 스크립트를
 * 따로 쓴다.
 */
type Props = {
  /** 기본값 대신 기록할 주소 */
  url?: string;
};

const { url = `${Astro.url.pathname}${Astro.url.search}` } = Astro.props;
---

<span data-back-url={url} hidden></span>

<script>
  function rememberBackUrl() {
    const marker = document.querySelector<HTMLElement>("[data-back-url]");
    const url = marker?.dataset.backUrl;
    if (url) sessionStorage.setItem("backUrl", url);
  }

  document.addEventListener("astro:page-load", rememberBackUrl);
  rememberBackUrl();
</script>
